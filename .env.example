# ── Database ──────────────────────────────────────────────────────────────────
# Used by the API service inside Docker
DATABASE_URL=postgresql+asyncpg://pricegrid:pricegrid@pricegrid-db:5432/pricegrid

# Used for local dev (outside Docker) — swap host to localhost
# DATABASE_URL=postgresql+asyncpg://pricegrid:pricegrid@localhost:5432/pricegrid

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by the API service inside Docker
REDIS_URL=redis://pricegrid-cache:6379

# Used for local dev (outside Docker)
# REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development # development | production | test

# Percentage deviation from 30-day average that triggers a price spike alert
SPIKE_THRESHOLD_PCT=20

# Redis cache TTL in seconds (safety net — cache is primarily invalidated on write)
CACHE_TTL_SECONDS=300
