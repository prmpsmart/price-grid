# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/
wheels/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── uv ────────────────────────────────────────────────────────────────────────
.uv-cache/
# uv.lock is committed — keeps builds reproducible
# pyproject.toml is committed — source of truth for dependencies

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Linting & type checking ───────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/

# ── Alembic ───────────────────────────────────────────────────────────────────
# Migration scripts are committed — never ignore alembic/versions/

# ── IDE & editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# docker-compose.yml and Dockerfile are committed
# Only ignore local override files
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.diff
logs/
